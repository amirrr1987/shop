# =============================================================================
# Shop — تنظیمات مرکزی (فقط این فایل را کپی/ویرایش کنید: cp .env.example .env)
#
# الگوی نام‌گذاری:
#   SHOP_<سرویس>_<ویژگی>
#
# سرویس‌ها: WEB | PANEL | API | DB | REDIS | PGADMIN | ADMIN
# ویژگی‌ها: HOST | PORT | URL | NAME | USER | PASS | SECRET
# =============================================================================

# --- عمومی ---
SHOP_ENV=development
SHOP_PUBLIC_HOST=localhost

# --- فروشگاه (Nuxt) — SHOP_WEB_* ---
SHOP_WEB_HOST=0.0.0.0
SHOP_WEB_PORT=3000
SHOP_WEB_URL=http://localhost:3000

# --- پنل مدیریت (Vite) — SHOP_PANEL_* ---
SHOP_PANEL_HOST=0.0.0.0
SHOP_PANEL_PORT=3001
SHOP_PANEL_URL=http://localhost:3001

# --- API (NestJS) — SHOP_API_* ---
SHOP_API_HOST=0.0.0.0
SHOP_API_PORT=3002
SHOP_API_URL=http://localhost:3002

# --- PostgreSQL — SHOP_DB_* ---
# SHOP_DB_PORT = پورت روی host (لوکال/VPS). داخل Docker همیشه 5432 است.
SHOP_DB_HOST=localhost
SHOP_DB_PORT=3004
SHOP_DB_NAME=shop_db
SHOP_DB_USER=shop_db_admin
SHOP_DB_PASS=shop_db_pass

# --- Redis — SHOP_REDIS_* ---
SHOP_REDIS_HOST=localhost
SHOP_REDIS_PORT=6380

# --- pgAdmin — SHOP_PGADMIN_* ---
SHOP_PGADMIN_PORT=3003
SHOP_PGADMIN_URL=http://localhost:3003
SHOP_PGADMIN_ADMIN=shop_pgadmin_admin
SHOP_PGADMIN_PASS=shop_pgadmin_pass

# --- احراز هویت API ---
SHOP_JWT_SECRET=change-me-in-local
SHOP_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- اکانت پیش‌فرض ادمین (seed پنل) — SHOP_ADMIN_* ---
SHOP_ADMIN_USER=shop_admin
SHOP_ADMIN_PASS=shop_admin_pass

# =============================================================================
# VPS (82.39.165.115) — این خطوط را جایگزین بلوک بالا کنید:
#
# SHOP_PUBLIC_HOST=82.39.165.115
# SHOP_WEB_URL=http://82.39.165.115:3000
# SHOP_PANEL_URL=http://82.39.165.115:3001
# SHOP_API_URL=http://82.39.165.115:3002
# SHOP_PGADMIN_URL=http://82.39.165.115:3003
# SHOP_DB_PORT=3004
# SHOP_CORS_ORIGINS=http://82.39.165.115:3000,http://82.39.165.115:3001
#
# اگر پشت Nginx فقط پورت 80 باز است، URLها را مطابق reverse proxy تنظیم کنید.
# =============================================================================
