# Copy to .env.docker and adjust before: docker compose --profile app up --build

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=shop

JWT_SECRET=change-me-to-a-long-secret-min-16
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=change-me-to-a-long-cookie-secret

CORS_ORIGINS=http://localhost:3000,http://localhost:5174
SWAGGER_ENABLED=false

PAYMENT_PROVIDER=mock
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
PAYMENT_CALLBACK_URL=http://localhost:3001/payments/callback
PAYMENT_RETURN_URL=http://localhost:3000/checkout/callback

ORDER_UNPAID_TTL_MINUTES=120
ADMIN_SEED_PASSWORD=change-me-strong-password

TYPEORM_SYNCHRONIZE=false
TYPEORM_RUN_MIGRATIONS=true

# Optional: docker compose --profile backup
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=14

LOG_FORMAT=json
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
NUXT_PUBLIC_SENTRY_DSN=
VITE_SENTRY_DSN=

# Uploads: local (default) or s3 with MinIO profile "storage"
STORAGE_DRIVER=local
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=shop
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/shop
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

MAIL_DRIVER=log
MAIL_FROM=Shop <noreply@shop.local>
WEB_APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

REDIS_ENABLED=true
REDIS_URL=redis://redis:6379
