NODE_ENV=development
PORT=4001

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=shop

JWT_SECRET=change-me-to-a-long-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=change-me-to-a-long-cookie-secret
# Dev: synchronize=true OK. Staging/prod: synchronize=false + run migrations.
TYPEORM_SYNCHRONIZE=true
# Auto-run pending migrations on boot (default true in production when sync is off).
TYPEORM_RUN_MIGRATIONS=false

LOG_FORMAT=pretty
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# local | s3 (MinIO / AWS). For MinIO see compose profile "storage".
STORAGE_DRIVER=local
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=shop
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_URL=http://127.0.0.1:9000/shop
S3_FORCE_PATH_STYLE=true

MAIL_DRIVER=log
MAIL_FROM=Shop <noreply@shop.local>
WEB_APP_URL=http://localhost:4000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Guest checkout OTP (log = code in API logs)
SMS_DRIVER=log
OTP_TTL_SECONDS=300

# Catalog cache (product detail / list / category / brand / settings)
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379

UPLOAD_DIR=uploads

# Comma-separated browser origins (web + panel)
CORS_ORIGINS=http://localhost:4000,http://localhost:5600
# Omit to auto-disable in production
SWAGGER_ENABLED=true

# Payment: mock (default) or zarinpal
PAYMENT_PROVIDER=mock
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
# Gateway hits the API; API verifies then redirects the shopper to RETURN_URL.
PAYMENT_CALLBACK_URL=http://localhost:4001/payments/callback
PAYMENT_RETURN_URL=http://localhost:4000/checkout/callback
ORDER_UNPAID_TTL_MINUTES=120
ADMIN_SEED_PASSWORD=change-me-strong-password
