NUXT_API_PROXY=http://127.0.0.1:3001
NUXT_PUBLIC_API_BASE=/api
# Canonical origin for SEO (canonical, OG, sitemap, robots Sitemap:).
# Local: http://localhost:3000
# Production: https://your-domain.ir  (https, no trailing slash, exact public host)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional analytics (leave empty to disable)
NUXT_PUBLIC_UMAMI_HOST=
NUXT_PUBLIC_UMAMI_WEBSITE_ID=
NUXT_PUBLIC_GA4_ID=

# Optional Sentry
NUXT_PUBLIC_SENTRY_DSN=
NUXT_PUBLIC_SENTRY_ENVIRONMENT=development
